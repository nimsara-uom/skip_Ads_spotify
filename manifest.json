{
  "manifest_version": 3,
  "name": "Stupefy!",
  "version": "0.1.0",
  "description": "An educational project demonstrating media playback manipulation in the browser.",
  "author": "Your Name",
  "homepage_url": "https://github.com/yourusername/stupefy",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://open.spotify.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/onboard/onboard.html", "src/onboard/onboard.css"],
      "matches": ["*://open.spotify.com/*"]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://open.spotify.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://open.spotify.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_badge_background_color": "#1DB954"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}